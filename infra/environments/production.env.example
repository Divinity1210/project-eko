# Project Eko — Production Environment Configuration (Public Launch: Virtual Economy Only, Fiat OFF)
NODE_ENV=production
PROJECT_EKO_ENV=production
PROJECT_EKO_GAME_PORT=3000
PROJECT_EKO_API_PORT=3001
PROJECT_EKO_REALTIME_PORT=3002
PROJECT_EKO_PUBLIC_API_URL=https://api.projecteko.ng
PROJECT_EKO_PUBLIC_REALTIME_URL=https://realtime.projecteko.ng
PROJECT_EKO_CORS_ORIGINS=https://play.projecteko.ng,https://ops.projecteko.ng
PROJECT_EKO_DATA_DIR=/var/lib/project-eko/production
DATABASE_URL=postgresql://eko_prod:${DB_PASSWORD}@postgres-primary.internal:5432/project_eko_prod?sslmode=verify-full
PROJECT_EKO_EVIDENCE_HMAC_KEY=${MANAGED_EVIDENCE_HMAC_KEY_PROD}
PROJECT_EKO_STAFF_BOOTSTRAP_KEY=${MANAGED_STAFF_BOOTSTRAP_KEY_PROD}
# Real-money payouts remain strictly disabled at initial public launch
PROJECT_EKO_ENABLE_LIVE_FIAT_PAYOUTS=false
PROJECT_EKO_ALLOW_SANDBOX_GRANTS=false
PROJECT_EKO_MAX_REQUEST_BODY_BYTES=262144
