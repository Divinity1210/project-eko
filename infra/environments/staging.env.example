# Project Eko — Staging Environment Configuration
NODE_ENV=staging
PROJECT_EKO_ENV=staging
PROJECT_EKO_GAME_PORT=3000
PROJECT_EKO_API_PORT=3001
PROJECT_EKO_REALTIME_PORT=3002
PROJECT_EKO_PUBLIC_API_URL=https://api-staging.projecteko.example
PROJECT_EKO_PUBLIC_REALTIME_URL=https://realtime-staging.projecteko.example
PROJECT_EKO_CORS_ORIGINS=https://staging.projecteko.example,https://ops-staging.projecteko.example
PROJECT_EKO_DATA_DIR=/var/lib/project-eko/staging
DATABASE_URL=postgresql://eko_staging:${DB_PASSWORD}@postgres-staging.internal:5432/project_eko_staging?sslmode=require
PROJECT_EKO_EVIDENCE_HMAC_KEY=${MANAGED_EVIDENCE_HMAC_KEY_STAGING}
PROJECT_EKO_STAFF_BOOTSTRAP_KEY=${MANAGED_STAFF_BOOTSTRAP_KEY_STAGING}
PROJECT_EKO_ENABLE_LIVE_FIAT_PAYOUTS=false
PROJECT_EKO_ALLOW_SANDBOX_GRANTS=false
PROJECT_EKO_MAX_REQUEST_BODY_BYTES=262144
